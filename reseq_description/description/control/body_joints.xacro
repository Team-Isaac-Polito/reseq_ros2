<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <!-- Create n_modules modules by recursively calling the loop macro -->
    <xacro:macro name="loop" params="module n_modules">
        <xacro:if value="${module &lt;= n_modules}">

            <!-- Wheels -->
            <!-- Note: The real robot is rear-wheel drive,
            so we only expose control interfaces for the rear (back) wheels. -->
            <xacro:control_wheel_factory id="${module}" pos="back" side="left" />
            <xacro:control_wheel_factory id="${module}" pos="back" side="right" />

            <!-- 3DOF Joint -->
            <xacro:if value="${module != 1}">
                <xacro:control_joint_factory id="${module}" />
            </xacro:if>

            <!-- Inter-module joint torque (MK2 MOD2/MOD3 hardware): TORQUE_ENABLE_DISABLE (0x74).
                 One command interface per motor group, 1=enable 0=disable; ReseqHardware packs them
                 into the uint16 bitfield and sends it on change.
                 joint: J1 left/right differential pitch/yaw motors (bits 2-3), owned by torque_controller
                 traction / roll: not claimed by any controller, they keep their initial_value. -->
            <xacro:if value="${module != 1 and '$(arg version)' == 'mk2'}">
                <xacro:unless value="$(arg sim_mode)">
                    <gpio name="mod${module}__torque">
                        <command_interface name="joint" />
                        <command_interface name="traction">
                            <param name="initial_value">1</param>
                        </command_interface>
                        <command_interface name="roll">
                            <param name="initial_value">0</param>
                        </command_interface>
                    </gpio>
                </xacro:unless>
            </xacro:if>

            <!-- IMU sensor hardware interfaces.
                 Sim: GazeboSimSystem reads the Gazebo IMU sensor and exposes these state interfaces.
                 Hardware: ReseqHardware reads CAN messages 0x92 (accel) and 0x93 (gyro)
                 from the STEVAL-MKI178V2 / ISM330DLC board via PicoLowLevel firmware.
                 imu_sensor_broadcaster reads these interfaces and publishes sensor_msgs/Imu. -->
            <sensor name="imu${module}">
                <state_interface name="orientation.x"/>
                <state_interface name="orientation.y"/>
                <state_interface name="orientation.z"/>
                <state_interface name="orientation.w"/>
                <state_interface name="angular_velocity.x"/>
                <state_interface name="angular_velocity.y"/>
                <state_interface name="angular_velocity.z"/>
                <state_interface name="linear_acceleration.x"/>
                <state_interface name="linear_acceleration.y"/>
                <state_interface name="linear_acceleration.z"/>
            </sensor>

            <xacro:loop module="${module + 1}" n_modules="${n_modules}" />

        </xacro:if>
    </xacro:macro>

    <xacro:loop module="1" n_modules="${NumModules}" />
            
</robot>