<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"  name="reseq">

  <xacro:arg name="use_ros2_control" default="true"/>
  <xacro:arg name="sim_mode" default="false"/>

  <xacro:include filename="$(find reseq_description)/description/macros/reseq_parameters.xacro" />
  
  <xacro:include filename="$(find reseq_description)/description/macros/inertial_macros.xacro" />

  <xacro:include filename="$(find reseq_description)/description/macros/utils.xacro" />

  <xacro:include filename="$(find reseq_description)/description/macros/reseq_body.xacro" />

  <xacro:include filename="$(find reseq_arm_mk2)/urdf/reseq_arm_mk2.xacro" />

  <joint name="body_to_arm_joint" type="fixed">
    <parent link="chassis1_link"/>
    <child link="arm_base_link"/>
    <origin xyz="${WheelBase/2} 0 0" />
  </joint>

  <!-- Real robot TCP frame matching the simulated camera holder frame. -->
  <xacro:unless value="$(arg sim_mode)">
    <joint name="tcp_joint" type="fixed">
      <origin xyz="0 -0.03 0.15" rpy="1.57 -1.57 0"/>
      <parent link="arm_roll_wrist_link"/>
      <child link="tcp"/>
    </joint>
    <link name="tcp"/>
  </xacro:unless>

  <xacro:include filename="$(find reseq_description)/description/control/ros2_control.xacro" />

  <!-- Cameras holder (RGBD + thermal) on the arm end-effector — Gazebo sim only -->
  <xacro:if value="$(arg sim_mode)">
    <xacro:include filename="$(find reseq_description)/description/sensors/gazebo/cameras_holder.xacro" />
  </xacro:if>

</robot>
