<?xml version="1.0" encoding="utf-8"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- Arm joints: position + velocity command interfaces on real hardware -->
    <!-- In sim, only position command is used (Gazebo provides velocity control) -->
    <joint name="mod1__base_pitch_arm_joint">
        <xacro:unless value="$(arg sim_mode)">
            <command_interface name="position" />
            <command_interface name="velocity" />
        </xacro:unless>
        <state_interface name="position">
            <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity" />
        <xacro:if value="$(arg sim_mode)">
            <command_interface name="position" />
        </xacro:if>
    </joint>
    <joint name="mod1__base_roll_arm_joint">
        <xacro:unless value="$(arg sim_mode)">
            <command_interface name="position" />
            <command_interface name="velocity" />
        </xacro:unless>
        <state_interface name="position">
            <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity" />
        <xacro:if value="$(arg sim_mode)">
            <command_interface name="position" />
        </xacro:if>
    </joint>
    <joint name="mod1__elbow_pitch_arm_joint">
        <xacro:unless value="$(arg sim_mode)">
            <command_interface name="position" />
            <command_interface name="velocity" />
        </xacro:unless>
        <state_interface name="position">
            <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity" />
        <xacro:if value="$(arg sim_mode)">
            <command_interface name="position" />
        </xacro:if>
    </joint>
    <joint name="mod1__forearm_roll_arm_joint">
        <xacro:unless value="$(arg sim_mode)">
            <command_interface name="position" />
            <command_interface name="velocity" />
        </xacro:unless>
        <state_interface name="position">
            <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity" />
        <xacro:if value="$(arg sim_mode)">
            <command_interface name="position" />
        </xacro:if>
    </joint>
    <joint name="mod1__wrist_pitch_arm_joint">
        <xacro:unless value="$(arg sim_mode)">
            <command_interface name="position" />
            <command_interface name="velocity" />
        </xacro:unless>
        <state_interface name="position">
            <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity" />
        <xacro:if value="$(arg sim_mode)">
            <command_interface name="position" />
        </xacro:if>
    </joint>
    <joint name="mod1__wrist_roll_arm_joint">
        <xacro:unless value="$(arg sim_mode)">
            <command_interface name="position" />
            <command_interface name="velocity" />
        </xacro:unless>
        <state_interface name="position">
            <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity" />
        <xacro:if value="$(arg sim_mode)">
            <command_interface name="position" />
        </xacro:if>
    </joint>
</robot>
