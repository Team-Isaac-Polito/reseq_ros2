controller_manager:
  ros__parameters:
    update_rate: 100
    use_sim_time: {{ use_sim_time | lower }}

    joint_state_broadcaster:
      type: joint_state_broadcaster/JointStateBroadcaster

{% if body_controllers %}
{% for i in range(num_modules) %}
    diff_controller{{ i + 1 }}:
      type: diff_drive_controller/DiffDriveController
{% endfor %}
{% endif %}

{% if yaw_controllers %}
{% for i in range(num_modules - 1) %}
    yaw_controller{{ i + 2 }}:
      type: forward_command_controller/ForwardCommandController
{% endfor %}
{% endif %}

{% if pitch_controllers %}
{% for i in range(num_modules - 1) %}
    pitch_controller{{ i + 2 }}:
      type: forward_command_controller/ForwardCommandController
{% endfor %}
{% endif %}

{% if body_controllers %}
{% for i in range(num_modules) %}
    imu{{ i + 1 }}_broadcaster:
      type: imu_sensor_broadcaster/IMUSensorBroadcaster
{% endfor %}
{% endif %}

{% if arm_controller %}
{% if not use_sim_time %}
    mk2_arm_controller:
      type: joint_trajectory_controller/JointTrajectoryController

{% endif %}
    joint_group_velocity_controller:
      type: velocity_controllers/JointGroupVelocityController

    beak_controller:
      type: forward_command_controller/ForwardCommandController
{% if not use_sim_time %}

    led_controller:
      type: forward_command_controller/ForwardCommandController
{% endif %}
{% endif %}

{% if torque_controller %}
    torque_controller:
      type: forward_command_controller/ForwardCommandController
{% endif %}

{% if body_controllers %}
{% for i in range(num_modules) %}
diff_controller{{ i + 1 }}:
  ros__parameters:
    left_wheel_names:
      - mod{{ i + 1 }}__left_back_wheel
    right_wheel_names:
      - mod{{ i + 1 }}__right_back_wheel
    position_feedback: false
    odom_frame_id: odom
    base_frame_id: rear_axle{{ i + 1 }}_link
    wheel_separation: {{ wheel_separation }}
    wheel_radius: {{ wheel_radius }}
    wheels_per_side: 1
    use_stamped_vel: true
    enable_odom_tf: false  # EKF node publishes odom->base_link TF instead
    enable_odom: true  # FTL uses the tail module's speed when reversing
    pose_covariance_diagonal: [0.001, 0.001, 0.0, 0.0, 0.0, 0.01]
    twist_covariance_diagonal: [0.001, 0.001, 0.0, 0.0, 0.0, 0.01]

{% endfor %}
{% endif %}

{% if arm_controller %}
{% if not use_sim_time %}
mk2_arm_controller:
  ros__parameters:
    joints:
      - mod1__base_pitch_arm_joint
      - mod1__base_roll_arm_joint
      - mod1__elbow_pitch_arm_joint
      - mod1__forearm_roll_arm_joint
      - mod1__wrist_pitch_arm_joint
      - mod1__wrist_roll_arm_joint
    command_interfaces:
      - position
    state_interfaces:
      - position
      - velocity
    action_monitor_rate: 10.0
    allow_nonzero_velocity_at_trajectory_start: false
    continue_last_state: false
    default_tolerances:
      goals: 0.1
      goal_state: 0.1

{% endif %}
joint_group_velocity_controller:
  ros__parameters:
    joints:
      - mod1__base_pitch_arm_joint
      - mod1__base_roll_arm_joint
      - mod1__elbow_pitch_arm_joint
      - mod1__forearm_roll_arm_joint
      - mod1__wrist_pitch_arm_joint
      - mod1__wrist_roll_arm_joint
    interface_name: velocity

# Sim: beak joint position. Hardware: ARM_ROLL_6_SETPOINT (0x5B), 0=close / 1=open.
beak_controller:
  ros__parameters:
    joints:
      - mod1__beak
    interface_name: position
{% if not use_sim_time %}

# LED_HP_BRIGHTNESS (0x75) on MOD1, commands: [brightness 0-255]
led_controller:
  ros__parameters:
    joints:
      - mod1__led
    interface_name: brightness
{% endif %}
{% endif %}

{% if torque_controller %}
# TORQUE_ENABLE_DISABLE (0x74) joint motors (bits 2-3) of MOD2..N, commands: [1=enable, 0=disable] per module
torque_controller:
  ros__parameters:
    joints:
{% for i in range(num_modules - 1) %}
      - mod{{ i + 2 }}__torque
{% endfor %}
    interface_name: joint

{% endif %}

{% if yaw_controllers %}
{% for i in range(num_modules - 1) %}
yaw_controller{{ i + 2 }}:
  ros__parameters:
    joints:
      - mod{{ i + 2 }}__yaw_joint
    interface_name: position

{% endfor %}
{% endif %}

{% if pitch_controllers %}
{% for i in range(num_modules - 1) %}
pitch_controller{{ i + 2 }}:
  ros__parameters:
    joints:
      - mod{{ i + 2 }}__pitch_joint
    interface_name: position

{% endfor %}
{% endif %}

{% if body_controllers %}
{% for i in range(num_modules) %}
imu{{ i + 1 }}_broadcaster:
  ros__parameters:
    sensor_name: imu{{ i + 1 }}
    frame_id: imu{{ i + 1 }}_link

{% endfor %}
{% endif %}
