<?xml version="1.0" encoding="utf-8"?>

<robot
  name="reseq_arm_mk2" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find reseq_description)/description/macros/reseq_parameters.xacro" />
  <link
    name="arm_base_link">
    <inertial>
      <origin
        xyz="0 -0.0031516 0"
        rpy="0 0 0" />
      <mass
        value="0.11481" />
      <inertia
        ixx="0.00037274"
        ixy="-3.8623E-21"
        ixz="-1.0431E-22"
        iyy="1.1022E-05"
        iyz="2.037E-21"
        izz="0.00037274" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://reseq_arm_mk2/meshes/arm_base_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.75294 0.75294 0.75294 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://reseq_arm_mk2/meshes/arm_base_link.STL" />
      </geometry>
    </collision>
  </link>
  <link
    name="arm_diff_pitch_link">
    <inertial>
      <origin
        xyz="-1.3878E-17 0.00059334 1.7347E-18"
        rpy="0 0 0" />
      <mass
        value="0.28931" />
      <inertia
        ixx="0.0002425"
        ixy="-1.6941E-20"
        ixz="-1.5531E-20"
        iyy="0.00023577"
        iyz="8.3058E-21"
        izz="0.00025759" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://reseq_arm_mk2/meshes/arm_diff_pitch_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.75294 0.75294 0.75294 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://reseq_arm_mk2/meshes/arm_diff_pitch_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="mod1__base_pitch_arm_joint"
    type="revolute">
    <origin
      xyz="0 0 0"
      rpy="1.5708 0.2 0" />
    <parent
      link="arm_base_link" />
    <child
      link="arm_diff_pitch_link" />
    <axis
      xyz="0 0 -1" />
    <limit
      lower="-0.1"
      upper="2.8"
      effort="${arm_pitch_effort}"
      velocity="2" />
    <dynamics damping="0.5" friction="0.1" />
  </joint>
  <link
    name="arm_diff_roll_link">
    <inertial>
      <origin
        xyz="-0.14664 7.62E-08 -1.1115E-08"
        rpy="0 0 0" />
      <mass
        value="0.11865" />
      <inertia
        ixx="1.0228E-05"
        ixy="2.2625E-10"
        ixz="9.7641E-11"
        iyy="0.00051383"
        iyz="2.7475E-10"
        izz="0.00051345" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 1.5708 0" />
      <geometry>
        <mesh
          filename="package://reseq_arm_mk2/meshes/arm_diff_roll_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.75294 0.75294 0.75294 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 1.5708 0" />
      <geometry>
        <mesh
          filename="package://reseq_arm_mk2/meshes/arm_diff_roll_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="mod1__base_roll_arm_joint"
    type="revolute">
    <origin
      xyz="0 0 0"
      rpy="0 0 0" />
    <parent
      link="arm_diff_pitch_link" />
    <child
      link="arm_diff_roll_link" />
    <axis
      xyz="1 0 0" />
    <limit
      lower="-3.14"
      upper="3.14"
      effort="${arm_base_roll_effort}"
      velocity="2" />
    <dynamics damping="0.5" friction="0.1" />
  </joint>
  <link
    name="arm_pitch_forearm_link">
    <inertial>
      <origin
        xyz="0.060867 0.046121 -5.2042E-18"
        rpy="0 0 0" />
      <mass
        value="0.10409" />
      <inertia
        ixx="4.6765E-05"
        ixy="-9.086E-05"
        ixz="1.3572E-20"
        iyy="0.00027451"
        iyz="3.2775E-21"
        izz="0.00031255" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://reseq_arm_mk2/meshes/arm_pitch_forearm_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.75294 0.75294 0.75294 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://reseq_arm_mk2/meshes/arm_pitch_forearm_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="mod1__elbow_pitch_arm_joint"
    type="revolute">
    <origin
      xyz="-0.28857 0 0"
      rpy="0 0 0.2" />
    <parent
      link="arm_diff_roll_link" />
    <child
      link="arm_pitch_forearm_link" />
    <axis
      xyz="0 0 1" />
    <limit
      lower="-0.1"
      upper="2.88"
      effort="${arm_pitch_effort}"
      velocity="2" />
    <dynamics damping="0.5" friction="0.1" />
  </joint>
  <link
    name="arm_roll_forearm_link">
    <inertial>
      <origin
        xyz="2.0817E-17 -0.0018789 0.03054"
        rpy="0 0 0" />
      <mass
        value="0.096867" />
      <inertia
        ixx="5.2065E-05"
        ixy="1.7168E-22"
        ixz="-6.5851E-21"
        iyy="4.9885E-05"
        iyz="2.3291E-07"
        izz="2.3052E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://reseq_arm_mk2/meshes/arm_roll_forearm_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.75294 0.75294 0.75294 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://reseq_arm_mk2/meshes/arm_roll_forearm_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="mod1__forearm_roll_arm_joint"
    type="revolute">
    <origin
      xyz="0.15351 0.074002 0"
      rpy="0.2618 -1.5708 3.14" />
    <parent
      link="arm_pitch_forearm_link" />
    <child
      link="arm_roll_forearm_link" />
    <axis
      xyz="0 0 1" />
    <limit
      lower="-3.14"
      upper="3.14"
      effort="${arm_forearm_roll_effort}"
      velocity="1" />
    <dynamics damping="0.5" friction="0.1" />
  </joint>
  <link
    name="arm_pitch_wrist_link">
    <inertial>
      <origin
        xyz="5.3776E-17 2.7756E-17 0.045311"
        rpy="0 0 0" />
      <mass
        value="0.056876" />
      <inertia
        ixx="1.6114E-05"
        ixy="3.0569E-22"
        ixz="-3.5109E-21"
        iyy="2.2881E-05"
        iyz="1.0674E-21"
        izz="1.5222E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 -1.5708 0" />
      <geometry>
        <mesh
          filename="package://reseq_arm_mk2/meshes/arm_pitch_wrist_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.75294 0.75294 0.75294 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 -1.5708 0" />
      <geometry>
        <mesh
          filename="package://reseq_arm_mk2/meshes/arm_pitch_wrist_link.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="mod1__wrist_pitch_arm_joint"
    type="revolute">
    <origin
      xyz="0 0 0.05447"
      rpy="-0.25 0 0" />
    <parent
      link="arm_roll_forearm_link" />
    <child
      link="arm_pitch_wrist_link" />
    <axis
      xyz="-1 0 0" />
    <limit
      lower="-0.46"
      upper="1.57"
      effort="${arm_wrist_pitch_effort}"
      velocity="1" />
    <dynamics damping="0.5" friction="0.1" />
  </joint>
  <link
    name="arm_roll_wrist_link">
    <inertial>
      <origin
        xyz="0.0001 0.0071 0.1197"
        rpy="0 0 0" />
      <mass
        value="0.1341" />
      <inertia
        ixx="1.332159E-04"
        ixy="0"
        ixz="-3.0E-10"
        iyy="1.128104E-04"
        iyz="-2.35230E-05"
        izz="4.67873E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://reseq_arm_mk2/meshes/beak_body.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.75294 0.75294 0.75294 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://reseq_arm_mk2/meshes/beak_body.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="mod1__wrist_roll_arm_joint"
    type="revolute">
    <origin
      xyz="0 0 0"
      rpy="0 0 0" />
    <parent
      link="arm_pitch_wrist_link" />
    <child
      link="arm_roll_wrist_link" />
    <axis
      xyz="0 0 -1" />
    <limit
      lower="-3.14"
      upper="3.14"
      effort="${arm_wrist_roll_effort}"
      velocity="1" />
    <dynamics damping="0.5" friction="0.1" />
  </joint>
  <link
    name="beak_finger_upper_link">
    <inertial>
      <origin
        xyz="0.0208 0.0127 0.0386"
        rpy="0 0 0" />
      <mass
        value="0.0233" />
      <inertia
        ixx="7.8788E-06"
        ixy="-6.43E-08"
        ixz="-2.019E-07"
        iyy="1.04238E-05"
        iyz="-2.6102E-06"
        izz="5.3419E-06" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://reseq_arm_mk2/meshes/beak_finger_upper.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.75294 0.75294 0.75294 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://reseq_arm_mk2/meshes/beak_finger_upper.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="mod1__beak"
    type="revolute">
    <origin
      xyz="-0.021 -0.0073 0.1307"
      rpy="0 0 0" />
    <parent
      link="arm_roll_wrist_link" />
    <child
      link="beak_finger_upper_link" />
    <axis
      xyz="1 0 0" />
    <limit
      lower="-0.05"
      upper="1.0"
      effort="${XL430Torque}"
      velocity="${XL430Velocity}" />
    <dynamics damping="0.5" friction="0.1" />
  </joint>

  <gazebo reference="arm_base_link">
    <material>Gazebo/Grey</material>
    <selfCollide>false</selfCollide>
  </gazebo>
  <gazebo reference="arm_diff_pitch_link">
    <material>Gazebo/Grey</material>
    <selfCollide>false</selfCollide>
  </gazebo>
  <gazebo reference="arm_diff_roll_link">
    <material>Gazebo/Grey</material>
    <selfCollide>false</selfCollide>
  </gazebo>
  <gazebo reference="arm_pitch_forearm_link">
    <material>Gazebo/Grey</material>
    <selfCollide>false</selfCollide>
  </gazebo>
  <gazebo reference="arm_roll_forearm_link">
    <material>Gazebo/Grey</material>
    <selfCollide>false</selfCollide>
  </gazebo>
  <gazebo reference="arm_pitch_wrist_link">
    <material>Gazebo/Grey</material>
    <selfCollide>false</selfCollide>
  </gazebo>
  <gazebo reference="arm_roll_wrist_link">
    <material>Gazebo/Grey</material>
    <selfCollide>false</selfCollide>
  </gazebo>
  <gazebo reference="beak_finger_upper_link">
    <material>Gazebo/Grey</material>
    <selfCollide>false</selfCollide>
  </gazebo>

  <!-- realsense link for camera mounting - attached to the wrist on the beak -->
  <xacro:unless value="$(arg sim_mode)">
    <link name="realsense_link">
          <visual name="cube">
              <origin xyz="0 0 0"/>
              <geometry>
                  <box size="0.01 0.01 0.01"/>
              </geometry>
              <material name="green">
                  <color rgba="0 1 0 1.0"/>
              </material>
          </visual>
      </link>

    <joint name="realsense_joint" type="fixed">
      <origin xyz="0 -0.03 0.15" rpy="1.57 -1.57 0"/>
      <parent link="arm_roll_wrist_link"/>
      <child link="realsense_link"/>
    </joint>
  </xacro:unless>
</robot>
